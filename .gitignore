# Binaries. Each tutorial step is its own project, so `ebigent build`
# and `ebigent simulate` put artifacts under its own bin/.
/bin/
/tutorial/step*/bin/
*.exe
*.wasm

# Test artifacts
*.test
*.out
coverage.*

# Recorded episodes: data:episode-log grows without bound and replays
# from its seed, so the directory is kept and its contents are not. The
# root one is where a tutorial step run from here writes; each step from
# step 2 on carries its own, because ebigent init puts one there.
/corpus/
/tutorial/step*/corpus/*
!/tutorial/step*/corpus/.gitkeep
/tutorial/step*/corpus-*/

# Editor
.DS_Store
.idea/
.vscode/

# Claude scratch
.claude/worktrees/
