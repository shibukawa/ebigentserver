# {{.Name}} — written by ebigent init. {{.Seats}} seat(s), {{.View}} view.
#
# One file, and a section prefix decides which struct binds a key: the
# ebigent tool reads [project], [build], [generate], [dev], and
# [behavior]; a built artifact reads [run]. Each ignores the other's
# sections, so both can share this file.
#
# Every key below also has an environment variable and a command-line
# option. The order is fixed: default < this file < environment < option.
# Run `ebigent config scaffold` to see every key with its default.

[project]
module = "{{.Module}}"
rules = "./game"
{{- if .GoVersion}}
go = "{{.GoVersion}}"
{{- end}}
{{range .Targets}}
[[build.target]]
name = "{{.Name}}"
kind = "{{.ConfigKind}}"
entry = "{{.Entry}}"
{{- if .Tagged}}

# The same directory also builds a listen server, which links a renderer
# and seats a local player. Only the linkage differs; both read [run].
[[build.target]]
name = "{{.Name}}-listen"
kind = "listen"
entry = "{{.Entry}}"
tags = ["listen"]
{{- end}}
{{end}}
[dev]
target = "{{.DevTarget}}"
console = "127.0.0.1:8930"

[behavior]
library = "behavior/chips.json"
corpus = "corpus"
skill = "skills/behavior-analyze"

[run]
topology = "{{.Topology}}"
{{- if ne .Topology "standalone"}}
listen = "127.0.0.1:4433"
{{- end}}
{{if .SyncMode}}sync.mode = "{{.SyncMode}}"{{end}}
{{- if .RequireUnreliable}}

# This game asks for a datagram channel, which rules out a websocket-only
# deployment. A turn-based game would not, and would run over any https
# endpoint with no certificate story of its own.
transport.require_unreliable = true
{{- end}}

# Recording is off until a directory is named. Turn it on before you need
# the data: a corpus cannot be collected retroactively.
# episode.dir = "corpus"
# episode.mode = "analysis_sampled"
