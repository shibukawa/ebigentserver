# {{.Name}} — written by ebigent init. {{.Style}}, {{.Seats}} seat(s){{if .SharedScreen}}, one shared stage{{end}}.
#
# One file, and a section prefix decides which struct binds a key: the
# ebigent tool reads [project], [build], [dev], and [behavior];
# a built artifact reads [run]. Each ignores the other's
# sections, so both can share this file.
#
# Every key below also has an environment variable and a command-line
# option. The order is fixed: default < this file < environment < option.
# Run `ebigent config scaffold` to see every key with its default.

[project]
module = "{{.Module}}"
{{- if .GoVersion}}
go = "{{.GoVersion}}"
{{- end}}
{{range .Targets}}
[[build.target]]
name = "{{.Name}}"
kind = "{{.ConfigKind}}"
entry = "{{.Entry}}"
{{- if .Tagged}}

# The same directory builds a headless server: the tag takes the renderer
# away rather than adding one, so the plain build above is the one you run
# while working. Only the linkage differs; both read [run].
[[build.target]]
name = "{{.DedicatedName}}"
kind = "dedicated"
entry = "{{.Entry}}"
tags = ["dedicated"]
{{- end}}
{{end}}
[dev]
target = "{{.DevTarget}}"
console = "127.0.0.1:8930"

[behavior]
library = "behavior/chips.json"
corpus = "corpus"

[run]
# A starting value, not a constraint: any seat count runs under either
# host. Switch to "listen" and run the -tags listen build to have a player
# hold the session — over WebRTC that needs no backend at all, which is
# how a party game ships as static files.
topology = "{{.Topology}}"
{{- if ne .Topology "standalone"}}
listen = "127.0.0.1:4433"
{{- end}}
{{if .SyncMode}}sync.mode = "{{.SyncMode}}"{{end}}
{{- if .RequireUnreliable}}

# This game asks for a datagram channel, which rules out a websocket-only
# deployment. A turn-based game would not, and would run over any https
# endpoint with no certificate story of its own.
transport.require_unreliable = true
{{- end}}

# Recording is off until a directory is named. Turn it on before you need
# the data: a corpus cannot be collected retroactively.
# episode.dir = "corpus"
# episode.mode = "analysis_sampled"
