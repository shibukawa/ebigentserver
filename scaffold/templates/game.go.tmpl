// Package game holds the rules of {{.Name}}: the one package every build
// target links unchanged (concept:build-target).
//
// Nothing here imports Ebitengine, or any engine at all. Rendering and
// keyboard reading live in the client entry point, which is the only
// package allowed to import one (rule:engine-import-confined-to-client-entry).
// That is also what lets a headless target drop the engine entirely — by
// never importing it, not by a build tag
// (decision:entry-points-over-build-tags).
//
// Nothing here asks what controls a slot either (decision:no-ai-game-mode).
// A human at a keyboard and the bot below reach these rules through the
// same session.Agent interface.
//
// What ebigent init generated is a playable placeholder: two birds fly
// through the same pipes, one flap button each. Replace it a piece at a
// time — the realtime loop around it already works.
package game

import (
	"context"
	"errors"
	"fmt"

	"github.com/shibukawa/ebigentserver/session"
	"github.com/shibukawa/fixmath"
)

// Field geometry in game units. The renderer scales these to pixels; the
// simulation never knows what a pixel is.
const (
	FieldW = 240
	FieldH = 320
	// BirdX is where both birds sit horizontally. They differ only in
	// height, so one pipe field is fair for both.
	BirdX  = 60
	BirdR  = 7
	PipeW  = 26
	GapH   = 96
	// PipeEvery is the spawn interval in ticks.
	PipeEvery = 90
	// TargetPipes ends the game, so a good pilot cannot fly forever and
	// an unattended simulation always terminates.
	TargetPipes = 10
)

// Motion constants. Every one is fixed point: rule:no-float-in-simulation
// keeps reals out of anything that has to reproduce bit for bit on
// another machine, which is what replay and rollback depend on.
var (
	// A flap held down rises at |flapVY| per tick and, once released,
	// coasts a further flapVY^2/(2*gravity) units. At -4 and 0.5 that
	// overshoot is 16 units, comfortably inside the 48-unit half gap —
	// the constraint to keep in mind when retuning these.
	gravity = fixmath.FromScaled(1, 1)  // 0.5 units per tick per tick
	flapVY  = fixmath.FromInt32(-4)     // upward is negative
	maxVY   = fixmath.FromInt32(8)
	pipeVX  = fixmath.FromInt32(-2)
	birdR   = fixmath.FromInt32(BirdR)
	halfGap = fixmath.FromInt32(GapH / 2)
	pipeHW  = fixmath.FromInt32(PipeW / 2)
	birdXF  = fixmath.FromInt32(BirdX)
	floorY  = fixmath.FromInt32(FieldH)
)

// Seats is how many concept:player-slot entries these rules declare. It
// is a rule, not a setting: changing it changes the game.
const Seats = {{.Seats}}

// The player slots. Slot 0 is reserved by the session, so slots start
// at 1.
const (
{{- range $i, $name := .SlotNames}}
	{{$name}} session.SlotID = {{addOne $i}}
{{- end}}
)

// Slots is the game-defined slot set.
func Slots() []session.SlotID {
	out := make([]session.SlotID, 0, Seats)
	for i := range Seats {
		out = append(out, session.SlotID(i+1))
	}
	return out
}

// Bird is one slot's flyer.
//
// Y and VY are fixed point stored as the int64 behind it, and the two
// methods below are where that ends. Everything the world commits has to
// cross a link, and the codec generator carries no named type from
// another package — fixmath.F64 and session.Tick both hit that — so a
// world holding one gets no codec at all and the game cannot be played
// over a link (requirement:stage-declares-its-wire).
type Bird struct {
	Y     int64
	VY    int64
	Alive bool
	// Passed counts pipes cleared, which is the score.
	Passed int32
}

// Height and Rise are Y and VY as arithmetic. Converting here rather
// than at every use keeps the raw form in the struct and nowhere else.
func (b Bird) Height() fixmath.F64 { return fixmath.FromRaw(b.Y) }
func (b Bird) Rise() fixmath.F64   { return fixmath.FromRaw(b.VY) }

// Pipe is one obstacle: a vertical wall with a gap centered on GapY.
// X and GapY are raw fixed point for the same reason Bird's are.
type Pipe struct {
	X    int64
	GapY int64
	// Cleared records, per slot index, that this pipe was already
	// counted, so a score cannot tick twice on one pipe.
	//
	// One bit per seat rather than an array of them. A fixed-size array
	// is not something the codec generator can decode into, and a slice
	// would make Pipe uncomparable — which the generated delta needs it
	// to be, since a delta is what changed between two of them. A
	// bitmask is both, and eight seats is already the ceiling init
	// generates for.
	Cleared uint8
}

// ClearedBy reports whether this pipe was already counted for a seat,
// and Clear records that it has been.
func (p Pipe) ClearedBy(i int) bool { return p.Cleared&(1<<uint(i)) != 0 }
func (p *Pipe) Clear(i int)         { p.Cleared |= 1 << uint(i) }

// Pos is the pipe's centre and Gap the height its opening is centred on.
func (p Pipe) Pos() fixmath.F64 { return fixmath.FromRaw(p.X) }
func (p Pipe) Gap() fixmath.F64 { return fixmath.FromRaw(p.GapY) }

// State is the concept:world-state: everything the session commits.
type State struct {
	// Tick is a plain uint64 rather than session.Tick, for the reason
	// Bird's fields are raw.
	Tick uint64
	// Bird is one entry per seat, in slot order. A slice for the same
	// reason Pipe.Cleared is one.
	Bird  []Bird
	Pipes []Pipe
	// Seed and Spawned describe the pipe field completely: the gap of
	// the n-th pipe is drawn from a generator derived from the two.
	//
	// The generator itself does not live here, and could not: it is a
	// named type from another package like the rest. Two plain numbers
	// say the same thing and travel — which is what
	// rule:shared-rng-seed actually asks for, since what it wants is
	// that the stream be a function of the state and never of the
	// clock.
	Seed    uint64
	Spawned int32
	// Since counts ticks since the last spawn.
	Since int32
	Over  bool
}

// Action is one concept:action. One button, which is the whole game.
type Action struct {
	Flap bool
}

// Sight is what one slot may see (concept:sight).
//
// It is a separate type from State on purpose. Narrowing what a slot can
// know later is a change to Project alone, and no controller can read
// around it because none ever receives a State.
type Sight struct {
	You session.SlotID
	// Self is the observing slot's bird; Others holds every other seat,
	// in slot order.
	Self   Bird
	Others []Bird
	// Pipes is the field ahead. Everything is visible here — see
	// concept:visibility-scope when some of it should not be.
	Pipes []Pipe
	Tick  session.Tick
	Over  bool
	// Signal travels with the sight so every controller has a
	// criterion without asking for one.
	Signal session.EvaluationSignal
}

// index maps a slot to its array position.
func index(slot session.SlotID) int { return int(slot) - 1 }

// RuleSet implements session.TickStageRuleSet: session.StageRuleSet plus Advance, which is
// what a realtime session needs.
type RuleSet struct{}

var _ session.TickStageRuleSet[State, Action, Sight] = RuleSet{}

// Start returns the opening position, derived from the session's shared
// RNG seed (rule:shared-rng-seed). Two runs with the same seed produce
// the same pipes, which is what makes an episode replayable.
func (RuleSet) Start(seed uint64) State {
	s := State{Seed: seed, Bird: make([]Bird, Seats)}
	mid := fixmath.FromInt32(FieldH / 2).Raw()
	for i := range s.Bird {
		s.Bird[i] = Bird{Y: mid, Alive: true}
	}
	s.spawn()
	return s
}

// spawn appends one pipe at the right edge with a random gap height.
//
// The generator is built from the seed and the spawn number rather than
// carried between calls. Same seed, same field — and because the two
// numbers are in the state, a peer that reconstructs the state
// reconstructs the field with it.
func (s *State) spawn() {
	const margin = GapH/2 + 20
	span := int64(FieldH - 2*margin)
	r := fixmath.NewRand(s.Seed + uint64(s.Spawned))
	gap := fixmath.FromInt32(int32(margin + int(r.Int64n(span))))
	s.Pipes = append(s.Pipes, Pipe{
		X:    fixmath.FromInt32(FieldW + PipeW).Raw(),
		GapY: gap.Raw(),
	})
	s.Since = 0
	s.Spawned++
}

// ActingSlots returns the slots still flying. A realtime session reads
// inputs from every slot each tick rather than asking whose turn it is,
// so this mainly answers "is anyone left".
func (RuleSet) ActingSlots(s *State) []session.SlotID {
	if s.Over {
		return nil
	}
	var out []session.SlotID
	for _, slot := range Slots() {
		if s.Bird[index(slot)].Alive {
			out = append(out, slot)
		}
	}
	return out
}

// Apply advances the state by one already-validated action. Legality was
// settled by Validator, so Apply cannot fail and must not re-check.
func (RuleSet) Apply(s *State, slot session.SlotID, a Action) {
	b := &s.Bird[index(slot)]
	if a.Flap && b.Alive {
		b.VY = flapVY.Raw()
	}
}

// Advance runs one simulation step after this tick's inputs were
// applied. This is the whole of the game's physics, and every line of it
// is integer arithmetic.
func (RuleSet) Advance(s *State) {
	if s.Over {
		return
	}
	// Each loop converts once at its top and writes back once at its
	// bottom. The arithmetic in between is the same fixed point it
	// always was; only what the struct holds changed.
	for i := range s.Bird {
		b := &s.Bird[i]
		if !b.Alive {
			continue
		}
		vy := b.Rise().Add(gravity).Min(maxVY)
		y := b.Height().Add(vy)
		b.VY, b.Y = vy.Raw(), y.Raw()
		if y.Sub(birdR) <= 0 || y.Add(birdR) >= floorY {
			b.Alive = false
		}
	}

	for i := range s.Pipes {
		s.Pipes[i].X = s.Pipes[i].Pos().Add(pipeVX).Raw()
	}
	// Drop pipes that have left the field, oldest first.
	keep := s.Pipes[:0]
	for _, p := range s.Pipes {
		if p.Pos().Add(pipeHW) > 0 {
			keep = append(keep, p)
		}
	}
	s.Pipes = keep

	for i := range s.Pipes {
		p := &s.Pipes[i]
		x, gap := p.Pos(), p.Gap()
		for j := range s.Bird {
			b := &s.Bird[j]
			if !b.Alive {
				continue
			}
			y := b.Height()
			if overlapsX(x) {
				if y.Sub(birdR) < gap.Sub(halfGap) || y.Add(birdR) > gap.Add(halfGap) {
					b.Alive = false
					continue
				}
			}
			if !p.ClearedBy(j) && x.Add(pipeHW) < birdXF.Sub(birdR) {
				p.Clear(j)
				b.Passed++
			}
		}
	}

	s.Since++
	if s.Since >= PipeEvery {
		s.spawn()
	}
	s.Tick++

	s.Over = true
	for _, b := range s.Bird {
		if b.Alive && b.Passed < TargetPipes {
			s.Over = false
		}
	}
}

// overlapsX reports whether a pipe at x covers the birds' column.
func overlapsX(x fixmath.F64) bool {
	return x.Sub(pipeHW) < birdXF.Add(birdR) && x.Add(pipeHW) > birdXF.Sub(birdR)
}

// Project builds a slot's sight.
func (g RuleSet) Project(s *State, slot session.SlotID) Sight {
	me := index(slot)
	others := make([]Bird, 0, Seats-1)
	for i, b := range s.Bird {
		if i != me {
			others = append(others, b)
		}
	}
	return Sight{
		You:    slot,
		Self:   s.Bird[me],
		Others: others,
		Pipes:  append([]Pipe(nil), s.Pipes...),
		Tick:   session.Tick(s.Tick),
		Over:   s.Over,
		Signal: g.Evaluate(s, slot),
	}
}

// Evaluate computes a slot's data:evaluation-signal. The session calls
// this; an agent never scores itself (rule:evaluation-computed-by-session).
func (RuleSet) Evaluate(s *State, slot session.SlotID) session.EvaluationSignal {
	me := s.Bird[index(slot)]
	best := int32(-1)
	for i, b := range s.Bird {
		if i != index(slot) && b.Passed > best {
			best = b.Passed
		}
	}
	sig := session.EvaluationSignal{
		Score:      int64(me.Passed),
		Progress:   fixmath.FromInt32(me.Passed).Div(fixmath.FromInt32(TargetPipes)),
		Evaluation: fixmath.FromInt32(me.Passed - best),
	}
	if !s.Over {
		return sig
	}
	switch {
	case best < 0:
		// A solo game has nobody to lose to: reaching the target wins.
		if me.Passed >= TargetPipes {
			sig.Terminal = session.Win
		} else {
			sig.Terminal = session.Lose
		}
	case me.Passed > best:
		sig.Terminal = session.Win
	case me.Passed < best:
		sig.Terminal = session.Lose
	default:
		sig.Terminal = session.Draw
	}
	return sig
}

// ErrDead is the one rejection Validator can produce.
var ErrDead = errors.New("this bird is no longer flying")

// Validator is api:action-validator: what is possible under the rules.
// It runs before Apply and must not mutate the state.
//
// One button leaves little to reject, which is the point: the hook is
// occupied and typed, so the first real rule has somewhere to go.
type Validator struct{}

// Legal reports whether the action can be applied in this state.
func (Validator) Legal(s *State, slot session.SlotID, a Action) error {
	if !s.Bird[index(slot)].Alive {
		return fmt.Errorf("%w: slot %d", ErrDead, slot)
	}
	return nil
}

// Tuning is data:session-tuning-profile: the timing and bandwidth
// constants of this game. The framework ships no defaults
// (decision:no-framework-tuning-defaults) because a flyer, a shooter,
// and a strategy game disagree on every value here.
//
// SendRate equals TickRate so a local renderer gets a fresh world every
// frame; a networked build lowers it and interpolates.
func Tuning() session.TuningProfile {
	return session.TuningProfile{
		TickRate:      {{.Tuning.TickRate}},
		SendRate:      {{.Tuning.SendRate}},
		SnapshotEvery: {{.Tuning.SnapshotEvery}},
		HistoryDepth:  {{.Tuning.HistoryDepth}},
	}
}

// Config assembles a session over these rules. Every entry point builds
// its session through here, so a rule change reaches all of them.
//
// broadcast receives the committed world at the send cadence: it is the
// seam where a renderer takes a copy and where local controllers are
// pumped. Pass nil for a session nobody is watching.
func Config(id string, seed uint64, broadcast func(session.Tick, *State)) session.Config[State, Action, Sight] {
	tuning := Tuning()
	return session.Config[State, Action, Sight]{
		ID:        id,
		Slots:     Slots(),
		RuleSet:      RuleSet{},
		Validator: Validator{},
		Seed:      seed,
		Tuning:    &tuning,
		Broadcast: broadcast,
	}
}

// Bot flies by aiming at the gap ahead: flap when it is below the target
// height. Deliberately minimal — this project's AI depth is meant to come
// from episode distillation, not from hand-written play.
type Bot struct {
	last Sight
	// Result is the outcome the session delivers at the end, kept so an
	// entry point can report it.
	Result session.Result
}

var _ session.Agent[Sight, Action] = (*Bot)(nil)

// Joined does nothing; the sight carries the slot.
func (*Bot) Joined(session.SlotID) {}

// Observe retains the latest sight.
func (b *Bot) Observe(obs Sight) { b.last = obs }

// Decide flaps when the bird has fallen below the next gap's centre.
func (b *Bot) Decide(context.Context) (Action, bool) {
	if !b.last.Self.Alive {
		return Action{}, false
	}
	target := fixmath.FromInt32(FieldH / 2)
	for _, p := range b.last.Pipes {
		if p.Pos().Add(pipeHW) >= birdXF.Sub(birdR) {
			target = p.Gap()
			break
		}
	}
	if b.last.Self.Height() > target {
		return Action{Flap: true}, true
	}
	return Action{}, false
}

// Ended is the session-end callback.
func (b *Bot) Ended(r session.Result) { b.Result = r }

// Driver pumps a local controller into a realtime session.
//
// A realtime session never calls Observe or Decide itself: input arrives
// through the slot's Inbox, because that is the same path a remote peer
// uses. A local controller therefore needs something to turn each
// broadcast world into an sight, ask for a decision, and submit
// it — which is all this is.
//
// OnWorld runs on the session's own goroutine, so a controller that
// blocks here stalls the tick. That is fine for the bot; a slow
// controller belongs behind step pacing instead
// (decision:dual-mode-agent-pacing).
type Driver struct {
	Slot  session.SlotID
	Agent session.Agent[Sight, Action]
	Inbox *session.Inbox[Action]
}

// OnWorld feeds one broadcast world to the controller.
func (d *Driver) OnWorld(state *State) {
	obs := RuleSet{}.Project(state, d.Slot)
	d.Agent.Observe(obs)
	if action, ok := d.Agent.Decide(context.Background()); ok {
		d.Inbox.Submit(action)
	}
}
