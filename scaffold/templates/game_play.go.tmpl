{{end}}// The playing form of {{.Name}}: a window, the local seats, and the
// session running beside them{{if .Target.Tagged}} — concept:listen-server-mode when
// remote peers join it{{end}}.
//
// This file is the only one that imports Ebitengine
// (rule:engine-import-confined-to-client-entry). Nothing under game/
// does, which is what lets the {{if .Target.Tagged}}dedicated build drop the engine by
// never linking this file{{else}}engine stay out of every headless
// target{{end}}.
//
// Keyboard reading happens here, where a raw key becomes a game action
// (rule:no-engine-input-in-game-logic).
package main

import (
	"context"
	"fmt"
	"image/color"
	"sync"

	"github.com/hajimehoshi/ebiten/v2"
	"github.com/hajimehoshi/ebiten/v2/ebitenutil"
	"github.com/hajimehoshi/ebiten/v2/inpututil"
	"github.com/hajimehoshi/ebiten/v2/vector"

	"{{.Module}}/game"
	"github.com/shibukawa/ebigentserver/session"
)

const scale = 2

// localSeats reports how many seats sit at this machine.
{{if .SharedScreen}}// Every seat does: one stage, one window, a key each.
func localSeats() int { return game.Seats }
{{else}}// One, since every player reads their own view from their own process.
func localSeats() int { return 1 }
{{end}}
var shown view

// onWorld keeps the latest committed world for the renderer.
func onWorld(w *gameState) { shown.store(w) }

// serve starts the session on its own goroutine and gives the main one to
// Ebitengine, which insists on it.
func serve(ctx context.Context, h *host) error {
	go func() {
		if err := h.session.RunRealtime(ctx, session.Paced); err != nil {
			fatal(err)
		}
	}()
	ebiten.SetWindowSize(game.FieldW*scale, game.FieldH*scale)
	ebiten.SetWindowTitle("{{.Name}}")
	return ebiten.RunGame(&app{inboxes: h.local})
}

// view holds the latest world for the renderer. Broadcast runs on the
// session goroutine and Draw on Ebitengine's, so the copy is taken under
// a lock — and it is a copy, because the session keeps mutating what it
// handed over.
type view struct {
	mu    sync.Mutex
	world game.State
	got   bool
}

func (v *view) store(w *gameState) {
	v.mu.Lock()
	defer v.mu.Unlock()
	v.world = *w
	v.world.Pipes = append([]game.Pipe(nil), w.Pipes...)
	v.got = true
}

func (v *view) load() (game.State, bool) {
	v.mu.Lock()
	defer v.mu.Unlock()
	return v.world, v.got
}

// app is the Ebitengine side: it reads input and draws, and holds no
// rules of its own.
type app struct {
	inboxes []*session.Inbox[game.Action]
}

// flapKeys binds one key per local seat. This is the whole of
// api:input-adapter at this scale.
var flapKeys = []ebiten.Key{
	ebiten.KeySpace,
	ebiten.KeyS,
	ebiten.KeyK,
	ebiten.KeyV,
	ebiten.KeyN,
	ebiten.KeyComma,
	ebiten.KeyQ,
	ebiten.KeyZ,
}

// Update turns each seat's key press into that seat's action.
func (a *app) Update() error {
	for i, inbox := range a.inboxes {
		if i >= len(flapKeys) {
			break
		}
		if inpututil.IsKeyJustPressed(flapKeys[i]) {
			inbox.Submit(game.Action{Flap: true})
		}
		if i == 0 && inpututil.IsKeyJustPressed(ebiten.KeyArrowUp) {
			inbox.Submit(game.Action{Flap: true})
		}
	}
	return nil
}

var (
	sky   = color.RGBA{0x7a, 0xc7, 0xe8, 0xff}
	pipeC = color.RGBA{0x3f, 0xa2, 0x4a, 0xff}
)

// seatColors gives each seat a colour, reused when there are more seats
// than colours.
var seatColors = []color.RGBA{
	{0xf7, 0xd0, 0x51, 0xff},
	{0xe0, 0x6c, 0x75, 0xff},
	{0x8b, 0xd4, 0x50, 0xff},
	{0xc6, 0x8c, 0xf0, 0xff},
}

// Draw renders the world. Nothing here decides anything: if the picture
// is wrong, the rules are wrong.
func (a *app) Draw(screen *ebiten.Image) {
	screen.Fill(sky)
	world, ok := shown.load()
	if !ok {
		return
	}
	for _, p := range world.Pipes {
		x := float32(p.X.FloorToInt()-game.PipeW/2) * scale
		gap := float32(p.GapY.FloorToInt()) * scale
		half := float32(game.GapH/2) * scale
		w := float32(game.PipeW) * scale
		vector.DrawFilledRect(screen, x, 0, w, gap-half, pipeC, false)
		vector.DrawFilledRect(screen, x, gap+half, w, float32(game.FieldH)*scale, pipeC, false)
	}
	for i, b := range world.Bird {
		if !b.Alive {
			continue
		}
		vector.DrawFilledCircle(screen,
			float32(game.BirdX)*scale, float32(b.Y.FloorToInt())*scale,
			float32(game.BirdR)*scale, seatColors[i%len(seatColors)], true)
	}
	msg := "space to flap   "
	if world.Over {
		msg = "game over   "
	}
	for i, b := range world.Bird {
		msg += fmt.Sprintf(" %d:%d", i+1, b.Passed)
	}
	ebitenutil.DebugPrintAt(screen, msg, 4, 4)
}

// Layout fixes the logical resolution; Ebitengine scales it to the window.
func (a *app) Layout(int, int) (int, int) { return game.FieldW * scale, game.FieldH * scale }
