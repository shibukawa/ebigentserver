// Command {{.Target.Name}} renders {{.Name}} with Ebitengine.
//
// This is a client entry point: the one kind of package allowed to import
// the engine (rule:engine-import-confined-to-client-entry). Nothing under
// game/ imports it, which is what lets a headless target drop the engine
// by never linking this package.
//
// Keyboard reading happens only here, where a raw key becomes a game
// action (rule:no-engine-input-in-game-logic). The session-side seat is
// session.Detached, exactly as it would be for a remote player — so the
// session cannot tell a local window from a network peer.
//
//	space or up arrow    flap
package main

import (
	"context"
	"fmt"
	"image/color"
	"os"
	"sync"

	"github.com/hajimehoshi/ebiten/v2"
	"github.com/hajimehoshi/ebiten/v2/ebitenutil"
	"github.com/hajimehoshi/ebiten/v2/inpututil"
	"github.com/hajimehoshi/ebiten/v2/vector"

	"{{.Module}}/game"
	"github.com/shibukawa/ebigentserver/config/confload"
	"github.com/shibukawa/ebigentserver/config/runconf"
	"github.com/shibukawa/ebigentserver/session"
)

// scale turns game units into pixels. The simulation never knows this
// number exists.
const scale = 2

func main() {
	run := runconf.Bind()
	if _, err := confload.Load(confload.Options{
		Owned:    runconf.Prefixes(),
		Validate: []func() error{func() error { return run.Validate() }},
	}); err != nil {
		fatal(err)
	}

	v := &view{}
	var drivers []*game.Driver

	s, err := session.New(game.Config("{{.Name}}-client", 1, func(_ session.Tick, world *game.State) {
		v.store(world)
		for _, d := range drivers {
			d.OnWorld(world)
		}
	}))
	if err != nil {
		fatal(err)
	}
	if err := s.OpenAdmission(); err != nil {
		fatal(err)
	}
	// The window's seat is Detached: its observations arrive as the
	// broadcast world the renderer already holds, so delivering them to
	// the seat too would duplicate the path a remote player would use.
	// The bot is admitted directly, because a local controller does want
	// the final observation and Ended.
	if err := s.Admit(game.SlotOne, session.Detached[game.Observation, game.Action]{}); err != nil {
		fatal(err)
	}
	bot := &game.Bot{}
	if err := s.Admit(game.SlotTwo, bot); err != nil {
		fatal(err)
	}
	playerInbox, err := s.Inbox(game.SlotOne)
	if err != nil {
		fatal(err)
	}
	botInbox, err := s.Inbox(game.SlotTwo)
	if err != nil {
		fatal(err)
	}
	drivers = append(drivers, &game.Driver{Slot: game.SlotTwo, Agent: bot, Inbox: botInbox})

	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	go func() {
		if err := s.RunRealtime(ctx, session.Paced); err != nil {
			fatal(err)
		}
	}()

	ebiten.SetWindowSize(game.FieldW*scale, game.FieldH*scale)
	ebiten.SetWindowTitle("{{.Name}}")
	if err := ebiten.RunGame(&app{view: v, inbox: playerInbox}); err != nil {
		fatal(err)
	}
}

// view holds the latest committed world for the renderer. Broadcast runs
// on the session goroutine and Draw on Ebitengine's, so the copy is taken
// under a lock — and it is a copy, because the session keeps mutating the
// state it handed over.
type view struct {
	mu    sync.Mutex
	world game.State
	got   bool
}

func (v *view) store(w *game.State) {
	v.mu.Lock()
	defer v.mu.Unlock()
	v.world = *w
	v.world.Pipes = append([]game.Pipe(nil), w.Pipes...)
	v.got = true
}

func (v *view) load() (game.State, bool) {
	v.mu.Lock()
	defer v.mu.Unlock()
	return v.world, v.got
}

// app is the Ebitengine side. It reads input and draws; it holds no
// rules, and every rule it needs it reads off the world.
type app struct {
	view  *view
	inbox *session.Inbox[game.Action]
}

// Update turns a key press into a game action. This is the whole of
// api:input-adapter's job at this scale.
func (a *app) Update() error {
	if inpututil.IsKeyJustPressed(ebiten.KeySpace) || inpututil.IsKeyJustPressed(ebiten.KeyArrowUp) {
		a.inbox.Submit(game.Action{Flap: true})
	}
	return nil
}

var (
	sky    = color.RGBA{0x7a, 0xc7, 0xe8, 0xff}
	pipeC  = color.RGBA{0x3f, 0xa2, 0x4a, 0xff}
	youC   = color.RGBA{0xf7, 0xd0, 0x51, 0xff}
	rivalC = color.RGBA{0xe0, 0x6c, 0x75, 0xff}
)

// Draw renders the world. Nothing here decides anything: if the picture
// is wrong, the rules are wrong.
func (a *app) Draw(screen *ebiten.Image) {
	screen.Fill(sky)
	world, ok := a.view.load()
	if !ok {
		return
	}
	for _, p := range world.Pipes {
		x := float32(p.X.FloorToInt()-game.PipeW/2) * scale
		gap := float32(p.GapY.FloorToInt()) * scale
		half := float32(game.GapH/2) * scale
		w := float32(game.PipeW) * scale
		vector.DrawFilledRect(screen, x, 0, w, gap-half, pipeC, false)
		vector.DrawFilledRect(screen, x, gap+half, w, float32(game.FieldH)*scale, pipeC, false)
	}
	for i, b := range world.Bird {
		if !b.Alive {
			continue
		}
		c := youC
		if i == 1 {
			c = rivalC
		}
		vector.DrawFilledCircle(screen,
			float32(game.BirdX)*scale, float32(b.Y.FloorToInt())*scale,
			float32(game.BirdR)*scale, c, true)
	}
	msg := fmt.Sprintf("space to flap    you %d   rival %d",
		world.Bird[0].Passed, world.Bird[1].Passed)
	if world.Over {
		msg = fmt.Sprintf("game over    you %d   rival %d",
			world.Bird[0].Passed, world.Bird[1].Passed)
	}
	ebitenutil.DebugPrintAt(screen, msg, 4, 4)
}

// Layout fixes the logical resolution; Ebitengine scales it to the window.
func (a *app) Layout(int, int) (int, int) { return game.FieldW * scale, game.FieldH * scale }

func fatal(err error) {
	os.Stderr.WriteString("{{.Target.Name}}: " + err.Error() + "\n")
	os.Exit(1)
}
