// Command {{.Target.Name}} hosts {{.Name}} headless: concept:dedicated-server-mode.
//
// It never imports Ebitengine — not by a build tag, but by not importing
// it (decision:entry-points-over-build-tags). The import graph check is
// what enforces that, so keep rendering out of this file.
//
// TRANSPORT SEAM. This entry hosts the session and seats local
// controllers. Accepting remote peers is the piece to add next, and the
// shape is already right: every seat here is session.Detached, receiving
// input through an Inbox, which is exactly how a networked peer arrives.
// Wiring package netplay in front changes this file and nothing under
// game/ (rule:session-independent-of-transport-and-agent-kind).
package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"

	"{{.Module}}/game"
	"github.com/shibukawa/ebigentserver/config/confload"
	"github.com/shibukawa/ebigentserver/config/runconf"
	"github.com/shibukawa/ebigentserver/session"
)

func main() {
	run := runconf.Bind()
	if _, err := confload.Load(confload.Options{
		Owned:    runconf.Prefixes(),
		Validate: []func() error{func() error { return run.Validate() }},
	}); err != nil {
		fatal(err)
	}
	fmt.Printf("{{.Target.Name}}: topology %s, sync %s, listen %q\n",
		run.Topology, run.Sync.Mode, run.Listen)

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
	defer stop()

	one, two := &game.Bot{}, &game.Bot{}
	var drivers []*game.Driver

	s, err := session.New(game.Config("{{.Name}}-server", 1, func(_ session.Tick, world *game.State) {
		for _, d := range drivers {
			d.OnWorld(world)
		}
	}))
	if err != nil {
		fatal(err)
	}
	if err := s.OpenAdmission(); err != nil {
		fatal(err)
	}
	// A local bot is admitted directly rather than as session.Detached:
	// the session delivers the final observation and Ended to whatever
	// sits in the seat, and a local controller wants both. Detached is
	// for a seat whose real controller is across a link, where local
	// delivery would duplicate the stream it already receives.
	for i, slot := range game.Slots() {
		agent := one
		if i == 1 {
			agent = two
		}
		if err := s.Admit(slot, agent); err != nil {
			fatal(err)
		}
		inbox, err := s.Inbox(slot)
		if err != nil {
			fatal(err)
		}
		drivers = append(drivers, &game.Driver{Slot: slot, Agent: agent, Inbox: inbox})
	}
	if err := s.RunRealtime(ctx, session.Paced); err != nil {
		fatal(err)
	}
	fmt.Printf("{{.Target.Name}}: session ended after %d ticks, slot 1 %s (%d pipes)\n",
		s.Tick(), one.Result.Signal.Terminal, one.Result.Signal.Score)
}

func fatal(err error) {
	fmt.Fprintln(os.Stderr, "{{.Target.Name}}:", err)
	os.Exit(1)
}
