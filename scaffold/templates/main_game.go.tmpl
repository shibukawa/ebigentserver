// Command {{.Name}} is {{.Name}}.
//
// It comes in two linkage forms out of this one directory:
{{if .Target.Tagged}}//
//	go build ./cmd/{{.Target.Dir}}                    plays and hosts, concept:listen-server-mode
//	go build -tags dedicated ./cmd/{{.Target.Dir}}    headless, concept:dedicated-server-mode
//
// The tag takes the renderer away rather than adding one, so the build a
// developer runs all day is the plain one and the shipped server is the
// deliberate variant (rule:build-tag-only-for-linkage). Everything else —
// the topology, the listen address, the synchronization mode — stays a
// run value both forms read from the same data:run-config.
//
// A tag rather than two entry points because the two forms cannot share a
// process: a headless server must not link the engine at all. A tag here
// rather than in a library because it never leaves this directory, so a
// missing tag fails at the entry point instead of somewhere distant
// (decision:entry-points-over-build-tags).
//
// The variant files supply exactly two things, and needing a third means
// the split was drawn in the wrong place:
//
//	localSlot() session.SlotID   the slot this build plays, 0 for none
//	serve(...) error             how the session loop is driven
//
// TRANSPORT SEAM. Remote seats are not wired yet. The shape is already
// right: every seat is session.Detached fed through an Inbox, which is
// exactly how a networked peer arrives, so putting package netplay in
// front changes this directory and nothing under game/.
{{else}}//
//	go build ./cmd/{{.Target.Dir}}
//
// One player, one process, no link — so there is no headless form to
// build and no transport to wire.
{{end}}package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"

	"{{.Module}}/game"
	"github.com/shibukawa/ebigentserver/config/confload"
	"github.com/shibukawa/ebigentserver/config/runconf"
	"github.com/shibukawa/ebigentserver/session"
)

// gameState names the world for the variant files, so the headless one
// needs no import of the game package at all.
type gameState = game.State

// host is what both linkage forms are handed: the session, the seats they
// did not take, and the inbox of any seat they did.
type host struct {
	session *session.Session[game.State, game.Action, game.Observation]
	bots    []*game.Bot
	// local holds the inbox of every seat this build plays, in slot
	// order. It is empty in a headless build.
	local []*session.Inbox[game.Action]
}

func main() {
	run := runconf.Bind()
	if _, err := confload.Load(confload.Options{
		Owned:    runconf.Prefixes(),
		Validate: []func() error{func() error { return run.Validate() }},
	}); err != nil {
		fatal(err)
	}

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
	defer stop()

	h := &host{}
	var drivers []*game.Driver

	s, err := session.New(game.Config("{{.Name}}", 1, func(_ session.Tick, world *gameState) {
		onWorld(world)
		for _, d := range drivers {
			d.OnWorld(world)
		}
	}))
	if err != nil {
		fatal(err)
	}
	h.session = s
	if err := s.OpenAdmission(); err != nil {
		fatal(err)
	}

	// The seat this build plays is Detached: its observations arrive as
	// the broadcast world the renderer already holds, so delivering them
	// to the seat as well would duplicate the path a remote player uses.
	// Every other seat gets a local bot, admitted directly because a
	// local controller does want the final observation and Ended.
	local := localSeats()
	for i, slot := range game.Slots() {
		if i < local {
			if err := s.Admit(slot, session.Detached[game.Observation, game.Action]{}); err != nil {
				fatal(err)
			}
			inbox, err := s.Inbox(slot)
			if err != nil {
				fatal(err)
			}
			h.local = append(h.local, inbox)
			continue
		}
		bot := &game.Bot{}
		h.bots = append(h.bots, bot)
		if err := s.Admit(slot, bot); err != nil {
			fatal(err)
		}
		inbox, err := s.Inbox(slot)
		if err != nil {
			fatal(err)
		}
		drivers = append(drivers, &game.Driver{Slot: slot, Agent: bot, Inbox: inbox})
	}

	if err := serve(ctx, h); err != nil {
		fatal(err)
	}
}

func fatal(err error) {
	fmt.Fprintln(os.Stderr, "{{.Name}}:", err)
	os.Exit(1)
}
