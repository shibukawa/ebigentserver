// Command {{.Target.Name}} runs {{.Name}} headless: concept:simulation-mode,
// session and local state only, no transport and no engine.
//
// It is the entry point automated playtests and AI training run through
// (requirement:offline-simulation), and the one that proves the rules do
// not need a human or a network to advance.
package main

import (
	"context"
	"fmt"
	"os"

	"{{.Module}}/game"
	"github.com/shibukawa/ebigentserver/config/confload"
	"github.com/shibukawa/ebigentserver/config/runconf"
	"github.com/shibukawa/ebigentserver/session"
)

func main() {
	run := runconf.Bind()
	if _, err := confload.Load(confload.Options{
		Owned:    runconf.Prefixes(),
		Validate: []func() error{func() error { return run.Validate() }},
	}); err != nil {
		fatal(err)
	}

	// The seed is the session's shared RNG stream (rule:shared-rng-seed).
	// Holding it fixed is what makes a run reproducible; vary it to
	// sweep, never to add entropy.
	const seed = 1

	s, err := session.New(game.Config("{{.Name}}-sim", seed))
	if err != nil {
		fatal(err)
	}
	if err := s.OpenAdmission(); err != nil {
		fatal(err)
	}
	one, two := &game.FirstFree{}, &game.FirstFree{}
	if err := s.Admit(game.SlotOne, one); err != nil {
		fatal(err)
	}
	if err := s.Admit(game.SlotTwo, two); err != nil {
		fatal(err)
	}
	if err := s.Run(context.Background()); err != nil {
		fatal(err)
	}

	fmt.Printf("{{.Name}} simulation: seed %d, %d ticks, slot 1 %s, slot 2 %s\n",
		seed, s.Tick(), one.Result.Signal.Terminal, two.Result.Signal.Terminal)
}

func fatal(err error) {
	fmt.Fprintln(os.Stderr, "{{.Target.Name}}:", err)
	os.Exit(1)
}
