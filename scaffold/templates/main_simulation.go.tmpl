// Command {{.Target.Name}} runs {{.Name}} headless: concept:training-mode,
// session and local state only, no transport and no engine.
//
// It is what `ebigent simulate` builds and runs, and it is the proof
// that the rules need neither a human nor a window to advance. Every
// seat is filled from Binding.NewAgent, so the same rules that carry a
// person at a keyboard produce a corpus with nobody watching.
//
// Recording is why this is worth running at all beyond a smoke test:
// every decision every seat made lands in data:episode-log with the
// sight it was made from, which is the input flow:behavior-tree-synthesis
// needs and the one thing a hand-written enemy loop never produces.
package main

import (
	"context"
	"fmt"
	"os"
	"os/signal"

	"{{.Module}}/game"
	"github.com/shibukawa/ebigentserver/config/confload"
	"github.com/shibukawa/ebigentserver/config/runconf"
	"github.com/shibukawa/ebigentserver/episode"
	"github.com/shibukawa/ebigentserver/run"
	"github.com/shibukawa/ebigentserver/session"
)

func main() {
	cfg := runconf.Bind()
	if _, err := confload.Load(confload.Options{
		Owned:    runconf.Prefixes(),
		Validate: []func() error{func() error { return cfg.Validate() }},
	}); err != nil {
		fatal(err)
	}

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
	defer stop()

	// Everything this run differs on is a [run.episode] value, which is
	// also how `ebigent simulate` passes down what it was asked for. The
	// same binary is a four-hundred-match training run and a smoke test.
	ep := cfg.Episode
	mode := episode.AnalysisSampled
	if ep.Mode == "replay_complete" {
		mode = episode.ReplayComplete
	}

	played, ticks := 0, session.Tick(0)
	err := run.Serve(ctx, game.Options(), game.Binding(), run.ServeOptions{
		Matches: ep.Matches,
		// The seed is the whole recipe: each match adds its index, so a
		// run reproduces from this one number (rule:shared-rng-seed).
		Seed: uint64(ep.Seed),
		// Unlimited rather than the tick rate, because a training run
		// has nobody watching and no reason to wait for a clock.
		Time:   session.Unlimited,
		Record: run.RecordOptions{Root: ep.Root, Mode: mode},
		OnMatch: func(res run.MatchResult) {
			played++
			ticks += res.Ticks
			fmt.Printf("match %d  seed %d  %d ticks", res.Index, res.Seed, res.Ticks)
			for _, out := range res.Outcomes {
				fmt.Printf("  slot %d %s (%d)", out.Slot, out.Signal.Terminal, out.Signal.Score)
			}
			fmt.Println()
		},
	})
	if err != nil {
		fatal(err)
	}
	fmt.Printf("\n{{.Name}}: %d matches, %d ticks", played, ticks)
	if ep.Root != "" {
		fmt.Printf(", recorded into %s", ep.Root)
	}
	fmt.Println()
}

func fatal(err error) {
	fmt.Fprintln(os.Stderr, "{{.Target.Name}}:", err)
	os.Exit(1)
}
