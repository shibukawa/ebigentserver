// Command {{.Target.Name}} runs {{.Name}} headless: concept:training-mode,
// session and local state only, no transport and no engine.
//
// It is what automated playtests and AI training run through
// (requirement:offline-simulation), and it is the proof that the rules
// need neither a human nor a window to advance. Unlimited pacing means it
// runs as fast as the machine allows rather than at the tick rate.
package main

import (
	"context"
	"fmt"
	"os"

	"{{.Module}}/game"
	"github.com/shibukawa/ebigentserver/config/confload"
	"github.com/shibukawa/ebigentserver/config/runconf"
	"github.com/shibukawa/ebigentserver/session"
)

func main() {
	run := runconf.Bind()
	if _, err := confload.Load(confload.Options{
		Owned:    runconf.Prefixes(),
		Validate: []func() error{func() error { return run.Validate() }},
	}); err != nil {
		fatal(err)
	}

	// Holding the seed fixed is what makes a run reproducible; vary it
	// to sweep, never to add entropy (rule:shared-rng-seed).
	const seed = 1

	bots := make([]*game.Bot, 0, len(game.Slots()))
	var drivers []*game.Driver

	s, err := session.New(game.Config("{{.Name}}-sim", seed, func(_ session.Tick, world *game.State) {
		for _, d := range drivers {
			d.OnWorld(world)
		}
	}))
	if err != nil {
		fatal(err)
	}
	if err := s.OpenAdmission(); err != nil {
		fatal(err)
	}
	// A local bot is admitted directly rather than as session.Detached:
	// the session delivers the final observation and Ended to whatever
	// sits in the seat, and a local controller wants both. Detached is
	// for a seat whose real controller is across a link, where local
	// delivery would duplicate the stream it already receives.
	for _, slot := range game.Slots() {
		bot := &game.Bot{}
		bots = append(bots, bot)
		if err := s.Admit(slot, bot); err != nil {
			fatal(err)
		}
		inbox, err := s.Inbox(slot)
		if err != nil {
			fatal(err)
		}
		drivers = append(drivers, &game.Driver{Slot: slot, Agent: bot, Inbox: inbox})
	}
	if err := s.RunRealtime(context.Background(), session.Unlimited); err != nil {
		fatal(err)
	}

	fmt.Printf("{{.Name}} simulation: seed %d, %d ticks", seed, s.Tick())
	for i, b := range bots {
		fmt.Printf(", slot %d %s (%d pipes)", i+1, b.Result.Signal.Terminal, b.Result.Signal.Score)
	}
	fmt.Println()
}

func fatal(err error) {
	fmt.Fprintln(os.Stderr, "{{.Target.Name}}:", err)
	os.Exit(1)
}
